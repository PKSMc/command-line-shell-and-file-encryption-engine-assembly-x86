IFNDEF MODULE_C_INC
MODULE_C_INC EQU <1>

DES_BLOCK_BYTES EQU 8

; All routines return a status code in EAX.
; DES_TransformBlock supports in-place operation.
DES_TransformBlock PROTO STDCALL :PTR BYTE, :PTR BYTE, :PTR BYTE, :DWORD
Feistel_F         PROTO STDCALL :PTR BYTE, :PTR BYTE, :PTR BYTE
ApplyPermutation  PROTO STDCALL :PTR BYTE, :PTR BYTE, :PTR BYTE, :DWORD
GetBitFromBuffer  PROTO STDCALL :PTR BYTE, :DWORD
Apply_PKCS7_Padding PROTO STDCALL :PTR BYTE, :DWORD, :DWORD
Remove_PKCS7_Padding PROTO STDCALL :PTR BYTE, :DWORD

ModuleC_Encrypt PROTO STDCALL :PTR BYTE, :PTR BYTE
ModuleC_Decrypt PROTO STDCALL :PTR BYTE, :PTR BYTE

; File transform status values.
DES_STATUS_OK             EQU 0
DES_STATUS_BAD_ARGUMENT   EQU 1
DES_STATUS_OPEN_INPUT     EQU 2
DES_STATUS_CREATE_OUTPUT  EQU 3
DES_STATUS_READ_ERROR     EQU 4
DES_STATUS_WRITE_ERROR    EQU 5
DES_STATUS_BAD_CIPHERTEXT EQU 6

ENDIF
